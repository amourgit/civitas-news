# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------
# Couche services/api/ — voir src/config/env.ts
# ------------------------------------------------------------

# URL de base du backend Backend-Core-Base (branche civitas-news).
# En multi-tenant, le sous-domaine détermine le tenant résolu côté backend
# (voir tenants/middleware.py) — ex: https://tenant1.civitasnews.org/api
VITE_API_BASE_URL="http://localhost:8000/api"

# Bascule mock / API réelle pour TOUS les services (auth, news, commentaires,
# sondages, liens, statistiques, notifications, administration).
#   - Non définie : mock en développement, réel en production (automatique).
#   - "true"      : force le mode mock (y compris en production, ex. démo).
#   - "false"     : force le mode réel (y compris en développement, pour
#                   tester contre un backend local).
# VITE_USE_MOCK_DATA=false
