# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------
# Couche services/api/ — voir src/config/env.ts
# ------------------------------------------------------------

# URL de base du backend Backend-Core-Base (branche civitas-news).
#
# LAISSER CETTE LIGNE ABSENTE/COMMENTÉE EN DÉVELOPPEMENT MULTI-TENANT.
# Sans elle, l'URL est reconstruite DYNAMIQUEMENT à chaque requête à
# partir du hostname RÉELLEMENT affiché dans le navigateur (voir
# src/config/env.ts:resolveApiBaseUrl / src/config/tenantHost.ts) :
# ouvrir le frontend sur http://civitas.localhost:3000 cible alors
# automatiquement http://civitas.localhost:8000/api (VITE_API_PORT,
# 8000 par défaut) — c'est ce qui permet au sous-domaine tenant de se
# propager correctement du navigateur jusqu'au backend.
#
# La définir ICI (comme avant l'introduction de ce mécanisme) ÉCRASE
# ce comportement avec une origine FIXE, quel que soit le sous-domaine
# réellement affiché : symptôme typique --  la page est ouverte sur
# civitas.localhost:3000 mais les requêtes partent vers
# localhost:8000 (domaine racine), le backend les rejette (voir
# tenants/middleware.py, réponse 400 "TENANT_REQUIRED") et/ou CORS les
# bloque si l'origine civitas.localhost:3000 n'est pas explicitement
# whitelistée pour cette cible fixe.
#
# À ne définir que pour un override volontaire et explicite (ex: un
# backend qui ne tourne pas en local, ou un besoin ponctuel de forcer
# une cible précise) :
# VITE_API_BASE_URL="http://localhost:8000/api"

# Port du backend en développement (Django `manage.py runserver`),
# utilisé UNIQUEMENT par la construction dynamique ci-dessus (ignoré si
# VITE_API_BASE_URL est défini). 8000 est le défaut de Django, à ajuster
# seulement si votre backend tourne sur un autre port.
# VITE_API_PORT=8000

# Tenant envoyé sur CHAQUE requête via l'en-tête X-Tenant-Domain (voir
# src/config/env.ts, src/services/api/token/authFetchInterceptor.ts),
# testé EN PARALLÈLE du sous-domaine par le backend
# (Backend-Core-Base, tenants/middleware.py:
# TenantMiddleware._resolve_tenant_dual) -- un seul des deux suffit.
#
# INDISPENSABLE en production sur Render (plan gratuit) : Render ne
# fournit aucun certificat TLS valide pour les sous-domaines de
# *.onrender.com, le Host vu par Django y est donc TOUJOURS son propre
# domaine racine, jamais un sous-domaine de tenant -- sans cet en-tête,
# aucune requête ne peut être rattachée au bon tenant. C'est la valeur à
# définir dans les variables d'environnement Vercel du déploiement.
#
# LAISSER CETTE LIGNE ABSENTE/COMMENTÉE EN DÉVELOPPEMENT MULTI-TENANT --
# comme pour VITE_API_BASE_URL ci-dessus, la définir fige le déploiement
# sur CE tenant, quel que soit le sous-domaine réellement affiché dans le
# navigateur. Non définie : repli automatique sur ce hostname réel
# (pratique en local, un sous-domaine par tenant sans rien configurer).
# VITE_TENANT_HOST=civitasnews


# Bascule mock / API réelle pour TOUS les services (auth, news, commentaires,
# sondages, liens, statistiques, notifications, administration).
#   - Non définie : mock en développement, réel en production (automatique).
#   - "true"      : force le mode mock (y compris en production, ex. démo).
#   - "false"     : force le mode réel (y compris en développement, pour
#                   tester contre un backend local).
# VITE_USE_MOCK_DATA=false
